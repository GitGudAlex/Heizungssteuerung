fragment 1430
mssfix

remote-cert-tls server


## Indefinatly try to resolv the host name of the OpenVPN server
resolv-retry infinite

## Do not bind to a specific local port number
nobind

## Try to preserv some state across restart
persist-key
persist-tun

## Set loglevel verbosity (set to 0 on PPC!)
verb 3

## Downgrade privileges after initialization (non-Windows only)
#user nobody
#group nobody

## We are a client
client

## Use UDP to connect to the server
proto udp

## Device to use
dev tun

## Specify the TAP-Win32 adapter name if you have more than one
#dev-node MyTap

## Connect to server and port
remote mi-vpn.mi.hdm-stuttgart.de 1198

## Vista and above: enable if you are using WINDOWS VISTA/7
#route-method exe
#route-delay 2

