{
  "extends": "astro/tsconfigs/strict",
  "ts-node": {
    "esm": true // «———— enabling ESM for ts-node
  },
  "compilerOptions": {
    // this ensures clean imports
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "svelte.config.js", "tailwind.config.mjs", "astro.config.mjs"]
}
