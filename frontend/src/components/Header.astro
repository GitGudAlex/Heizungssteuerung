---
import Navigation from '../components/Navigation.astro'
import { Icon } from 'astro-icon/components'
import { getLangFromUrl, useTranslations } from '~/i18n/utils';
import checkAuth from '~/utils/auth/CheckAuth';
import checkAdmin from '~/utils/auth/CheckAdmin';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

var isAuthorized = false;
var isAdmin = false;
if(!Astro.cookies.has('token')) {
    isAuthorized = false
} else {
    var token = Astro.cookies.get('token');
    var auth = await checkAuth(token);
    if(auth === false) {
        isAuthorized = false
    } else {
        isAuthorized = true
    }
    isAdmin = await checkAdmin(token);
}
---

<header>
  <Navigation>
    {isAuthorized && (<li class="menu-item">
      <a href={`/${lang}/dashboard`}>{t('dashboard')}</a>
    </li>
    <li class="menu-item">
      <a href={`/${lang}/settings`}>{t('nav.settings')}</a>
    </li>
    )}
    {isAuthorized && isAdmin && (<li class="menu-item">
      <a href={`/${lang}/admin`}>{t('adminArea')}</a>
    </li>
    )}
    <li class="menu-item has-dropdown">
      <button aria-haspopup="true" aria-expanded="false">{t('nav.help')}</button>
      <ul class="dropdown-menu">
        <li class="submenu-item">
          <a href={`/${lang}/help/user-manual`}>{t('nav.help.userManual')}</a>
        </li>
        <li class="submenu-item">
          <a href=`/${lang}/help/installation-guide`}>{t('nav.help.installationGuide')}</a>
        </li>
      </ul>
    </li>
    <li class="menu-item type-icon">
      <a href="https://gitlab.mi.hdm-stuttgart.de/tz023/heizungssteuerung" title={t('goToGitlab')} target="_blank">
        <Icon name="ion:logo-gitlab" />
      </a>
    </li>
  </Navigation>
</header>

<style lang="scss" is:global>
  @use '../assets/scss/base/outline' as *;

  header {
    .type-icon a {
      display: block;

      [data-icon] {
        height: auto;
        margin-top: -4px;
        width: 30px;

        path {
          fill: var(--action-color);
        }
      }

      &:hover {
        [data-icon] path {
          fill: var(--action-color-state);
        }
      }
    }
  }
</style>
