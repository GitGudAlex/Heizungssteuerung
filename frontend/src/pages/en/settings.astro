---
import DefaultLayout from "~/layouts/DefaultLayout.astro";

import { getLangFromUrl, useTranslations } from '~/i18n/utils';
import checkAuth from "~/utils/auth/CheckAuth";
import AuthLogout from "~/components/auth/AuthLogout.svelte";
import SepiaToggle from "~/components/settings/SepiaToggle.svelte";
import getUserId from "~/utils/auth/GetUserId";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

if(!Astro.cookies.has('token')) {
    return Astro.redirect('/401');
} else {
    var token = Astro.cookies.get('token');
    var auth = await checkAuth(token);
    if(auth === false) {
        console.log('User not authorized');
        return Astro.redirect('/401');
    } else {
        console.log('User authorized');
    }
}
const userId = await getUserId(token);

const sepiaTranslations: Record<string, string> =  await {
    "sepiaMode": t('sepiaMode'),
    "sepiaModeOn": t('sepiaModeOn'),
    "sepiaModeOff": t('sepiaModeOff'),
    "sepiaModeDesc": t('sepiaModeDescription'),
};

const logoutTranslations: Record<string, string> =  await {
    "logout": t('logout'),
};
---
<DefaultLayout title={t('nav.settings')}>
    <section class="mb-12 mt-12">
        <div class="container">
        <h2 class="mb-16 text-6xl">{t('nav.settings')}</h2>
        <SepiaToggle client:load translations={sepiaTranslations} lang={lang} userId={userId} />
        <AuthLogout client:load translations={logoutTranslations} lang={lang}  />   
        </div>
    </section>
</DefaultLayout>