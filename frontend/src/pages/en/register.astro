---
import DefaultLayout from "~/layouts/DefaultLayout.astro";
import AuthRegister from "~/components/auth/AuthRegister.svelte";

import { getLangFromUrl, useTranslations } from '~/i18n/utils';
import checkAuth from "~/utils/auth/CheckAuth";
import { Image } from 'astro:assets'
import logo from '../../assets/img/warning.svg'
import { ui } from "~/i18n/ui";
import config from "~/utils/config";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const translations = ui[lang];

if (Astro.cookies.has('token')) {
    var token = Astro.cookies.get('token');
    var auth = await checkAuth(token);
    if(auth === true) {
        return Astro.redirect('/' + lang + '/dashboard');
    }
}

---
<DefaultLayout title={t('register')}>
    <section class="mb-12 mt-12">
        <div class="container">
        <h1 class="mb-16 text-6xl">{t('register')}</h1>
        <a href={`/${lang}/help/user-manual`} class="flex items-center gap-2 !no-underline">
            <Image src={logo} alt={`${t('disclaimerSign')}`} width="47" height="37" />
            <span class="font-bold">{t('registerDisclaimer')}</span>
        </a>
        <br>
        <AuthRegister client:only translations={translations} lang={lang} backendUrl={config.BACKEND_URL_CLIENT}/>
        </div>
    </section>
</DefaultLayout>