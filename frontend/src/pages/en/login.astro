---
import DefaultLayout from "~/layouts/DefaultLayout.astro";
import AuthLogin from "~/components/auth/AuthLogin.svelte";

import { getLangFromUrl, useTranslations } from '~/i18n/utils';
import checkAuth from "~/utils/auth/CheckAuth";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const loginTranslations: Record<string, string> =  await {
    "username": t('username'),
    "password": t('password'),
    "login": t('login'),
    "createAccount": t('createAccount'),
    "loginFailed": t('loginFailed'),
    "genericError": t('genericError'),
    "internalError": t('internalError'),
};

if (Astro.cookies.has('token')) {
    var token = Astro.cookies.get('token');
    var auth = await checkAuth(token);
    if(auth === true) {
        return Astro.redirect('/' + lang + '/dashboard');
    }
}

---
<DefaultLayout title={t('login')}>
    <section class="mb-12 mt-12">
        <div class="container">
        <h2 class="mb-16 text-6xl">{t('login')}</h2>
        <AuthLogin client:load translations={loginTranslations} lang={lang}  />
        </div>
    </section>
</DefaultLayout>