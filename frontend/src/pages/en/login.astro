---
import DefaultLayout from "~/layouts/DefaultLayout.astro";
import AuthLogin from "~/components/auth/AuthLogin.svelte";

import { getLangFromUrl, useTranslations } from '~/i18n/utils';
import checkAuth from "~/utils/auth/CheckAuth";
import { ui } from "~/i18n/ui";
import config from "~/utils/config";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const translations = ui[lang];

if (Astro.cookies.has('token')) {
    var token = Astro.cookies.get('token');
    var auth = await checkAuth(token);
    if(auth === true) {
        return Astro.redirect('/' + lang + '/dashboard');
    }
}

---
<DefaultLayout title={t('login')}>
    <section class="mb-12 mt-12">
        <div class="container">
        <h1 class="mb-16 text-6xl">{t('login')}</h1>
        <AuthLogin client:load translations={translations} lang={lang} backendUrl={config.BACKEND_URL_CLIENT} />
        </div>
    </section>
</DefaultLayout>