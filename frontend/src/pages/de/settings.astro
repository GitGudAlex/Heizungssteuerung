---
import DefaultLayout from "~/layouts/DefaultLayout.astro";

import { getLangFromUrl, useTranslations } from '~/i18n/utils';
import checkAuth from "~/utils/auth/CheckAuth";
import AuthLogout from "~/components/auth/AuthLogout.svelte";
import SepiaToggle from "~/components/settings/SepiaToggle.svelte";
import getUserId from "~/utils/auth/GetUserId";
import Temperature from "~/components/settings/Temperature.svelte";
import RoomSettings from "~/components/settings/RoomSettings.svelte";
import TextSizeSettings from "~/components/settings/TextSizeSettings.svelte";
import { ui } from "~/i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translations = ui[lang];

if(!Astro.cookies.has('token')) {
    return Astro.redirect('/401');
} else {
    var token = Astro.cookies.get('token');
    var auth = await checkAuth(token);
    if(auth === false) {
        console.log('User not authorized');
        return Astro.redirect('/401');
    } else {
        console.log('User authorized');
    }
}
const userId = await getUserId(token);
---
<DefaultLayout title={t('nav.settings')}>
    <section class="mb-12 mt-12">
        <div class="container">
        <h2 class="mb-16 text-6xl">{t('nav.settings')}</h2>
        <Temperature client:load translations={translations} lang={lang} userId={userId} />
        <RoomSettings client:load translations={translations} lang={lang} userId={userId} />
        <SepiaToggle client:load translations={translations} lang={lang} userId={userId} />
        <TextSizeSettings client:load translations={translations} lang={lang} userId={userId} />
        <AuthLogout client:load translations={translations} lang={lang}  />   
        </div>
    </section>
</DefaultLayout>