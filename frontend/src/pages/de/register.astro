---
import DefaultLayout from "~/layouts/DefaultLayout.astro";
import AuthRegister from "~/components/auth/AuthRegister.svelte";

import { getLangFromUrl, useTranslations } from '~/i18n/utils';
import checkAuth from "~/utils/auth/CheckAuth";
import { Image } from 'astro:assets'
import logo from '../../assets/img/warning.svg'
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const translations: Record<string, string> =  {
"username": t('username'),
"password": t('password'),
"roomMap": t('roomMap'),
"register": t('register'),
"loginNow": t('loginNow'),
"invitationCode": t('invitationCode'),
"invalidInviteCode": t('invalidInviteCode'),
"usernameTakenError": t('usernameTakenError'),
"genericError": t('genericError'),
"internalError": t('internalError'),
"passwordLengthError": t('passwordLengthError'),
};

if (Astro.cookies.has('token')) {
    var token = Astro.cookies.get('token');
    var auth = await checkAuth(token);
    if(auth === true) {
        return Astro.redirect('/' + lang + '/dashboard');
    }
}

---
<DefaultLayout title={t('register')}>
    <section class="mb-12 mt-12">
        <div class="container">
        <h2 class="mb-16 text-6xl">{t('register')}</h2>
        <a href={`/${lang}/help/user-manual`} class="flex items-center gap-2 !no-underline">
            <Image src={logo} alt={`${t('disclaimerSign')}`} width="47" height="37" />
            <span class="font-bold">{t('registerDisclaimer')}</span>
        </a>
        <br>
        <AuthRegister client:only translations={translations} lang={lang} />
        </div>
    </section>
</DefaultLayout>